generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  TECHNICIAN
}

enum RepairStatus {
  CREATED
  IN_PROGRESS
  REVIEW
  REVISION
  COMPLETED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  login        String   @unique @db.VarChar(50)
  passwordHash String
  name         String   @db.VarChar(100)
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @db.Timestamp(3)
  repairs      Repair[]

  @@map("users")
}

model Repair {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(150)
  description  String?
  technicianId String?      @db.Uuid
  dueDate      DateTime     @db.Date
  status       RepairStatus @default(CREATED)
  createdAt    DateTime     @default(now()) @db.Timestamp(3)
  updatedAt    DateTime     @updatedAt @db.Timestamp(3)
  technician   User?        @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([technicianId])
  @@index([status])
  @@index([dueDate])
  @@map("repairs")
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("user_sessions")
}

model MainCategory {
  id                   String                           @id @default(uuid()) @db.Uuid
  name                 String                           @unique @db.VarChar(100)
  createdAt            DateTime                         @default(now()) @db.Timestamp(3)
  updatedAt            DateTime                         @updatedAt @db.Timestamp(3)
  additionalCategories MainCategoryAdditionalCategory[]
  inventoryItems       InventoryItem[]

  @@map("main_categories")
}

model AdditionalCategory {
  id             String                           @id @default(uuid()) @db.Uuid
  name           String                           @unique @db.VarChar(100)
  createdAt      DateTime                         @default(now()) @db.Timestamp(3)
  updatedAt      DateTime                         @updatedAt @db.Timestamp(3)
  mainCategories MainCategoryAdditionalCategory[]
  inventoryItems InventoryItem[]

  @@map("additional_categories")
}

model MainCategoryAdditionalCategory {
  mainCategoryId       String             @db.Uuid
  additionalCategoryId String             @db.Uuid
  mainCategory         MainCategory       @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  additionalCategory   AdditionalCategory @relation(fields: [additionalCategoryId], references: [id], onDelete: Cascade)

  @@id([mainCategoryId, additionalCategoryId])
  @@index([additionalCategoryId])
  @@map("main_category_additional_categories")
}

model InventoryItem {
  id                   String              @id @default(uuid()) @db.Uuid
  name                 String              @db.VarChar(150)
  description          String?
  count                Int                 @default(0)
  mainCategoryId       String              @db.Uuid
  additionalCategoryId String?             @db.Uuid
  createdAt            DateTime            @default(now()) @db.Timestamp(3)
  updatedAt            DateTime            @updatedAt @db.Timestamp(3)
  mainCategory         MainCategory        @relation(fields: [mainCategoryId], references: [id], onDelete: Restrict)
  additionalCategory   AdditionalCategory? @relation(fields: [additionalCategoryId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([mainCategoryId])
  @@index([additionalCategoryId])
  @@index([mainCategoryId, additionalCategoryId])
  @@map("inventory_items")
}
