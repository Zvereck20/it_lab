generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  TECHNICIAN
}

enum RepairStatus {
  CREATED
  DIAGNOSTICS
  APPROVAL
  IN_PROGRESS
  REVISION
  COMPLETED
}

enum CustomerType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum RepairAssignmentMode {
  FREE_QUEUE
  ASSIGNED
}

enum HistoryActorRole {
  ADMIN
  MANAGER
  TECHNICIAN
}

enum OrderStatus {
  CREATED
  DIAGNOSTICS
  APPROVAL
  IN_PROGRESS
  REVISION
  COMPLETED
}

enum OrderAssignmentMode {
  FREE_QUEUE
  ASSIGNED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  login        String   @unique @db.VarChar(50)
  passwordHash String
  name         String   @db.VarChar(100)
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @db.Timestamp(3)
  repairs      Repair[]
  statusChanges RepairStatusHistory[]
  orders       Order[]
  orderStatusChanges OrderStatusHistory[]

  @@map("users")
}

model Repair {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String               @db.VarChar(150)
  description        String?
  customerType       CustomerType         @default(INDIVIDUAL)
  customerPhone      String               @db.VarChar(30)
  customerFirstName  String               @db.VarChar(100)
  customerLastName   String               @db.VarChar(100)
  customerMiddleName String?              @db.VarChar(100)
  companyName        String?              @db.VarChar(150)
  inn                String?              @db.VarChar(12)
  assignmentMode     RepairAssignmentMode @default(FREE_QUEUE)
  technicianId       String?              @db.Uuid
  status             RepairStatus         @default(CREATED)
  createdAt          DateTime             @default(now()) @db.Timestamp(3)
  updatedAt          DateTime             @updatedAt @db.Timestamp(3)
  technician         User?                @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  statusHistory      RepairStatusHistory[]

  @@index([name])
  @@index([technicianId])
  @@index([status])
  @@index([assignmentMode])
  @@map("repairs")
}

model RepairStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  repairId        String       @db.Uuid
  status          RepairStatus
  changedAt       DateTime     @default(now()) @db.Timestamp(3)
  changedByUserId String?      @db.Uuid
  changedByName   String       @db.VarChar(100)
  changedByRole   HistoryActorRole?
  comment         String?
  repair          Repair       @relation(fields: [repairId], references: [id], onDelete: Cascade)
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([repairId, changedAt])
  @@index([changedByUserId])
  @@map("repair_status_history")
}

model Order {
  id                    String                       @id @default(uuid()) @db.Uuid
  name                  String                       @db.VarChar(150)
  description           String?
  companyName           String                       @db.VarChar(150)
  inn                   String                       @db.VarChar(12)
  customerPhone         String                       @db.VarChar(30)
  contactFirstName      String                       @db.VarChar(100)
  contactLastName       String                       @db.VarChar(100)
  contactMiddleName     String?                      @db.VarChar(100)
  mainCategoryId        String                       @db.Uuid
  assignmentMode        OrderAssignmentMode          @default(FREE_QUEUE)
  technicianId          String?                      @db.Uuid
  status                OrderStatus                  @default(CREATED)
  createdAt             DateTime                     @default(now()) @db.Timestamp(3)
  updatedAt             DateTime                     @updatedAt @db.Timestamp(3)
  mainCategory          OrderMainCategory            @relation(fields: [mainCategoryId], references: [id], onDelete: Restrict)
  additionalCategories  OrderAdditionalCategoryLink[]
  technician            User?                        @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  statusHistory         OrderStatusHistory[]

  @@index([name])
  @@index([mainCategoryId])
  @@index([technicianId])
  @@index([status])
  @@index([assignmentMode])
  @@map("orders")
}

model OrderStatusHistory {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @db.Uuid
  status          OrderStatus
  changedAt       DateTime          @default(now()) @db.Timestamp(3)
  changedByUserId String?           @db.Uuid
  changedByName   String            @db.VarChar(100)
  changedByRole   HistoryActorRole?
  comment         String?
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User?             @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, changedAt])
  @@index([changedByUserId])
  @@map("order_status_history")
}

model OrderMainCategory {
  id                   String                                @id @default(uuid()) @db.Uuid
  name                 String                                @unique @db.VarChar(100)
  createdAt            DateTime                              @default(now()) @db.Timestamp(3)
  updatedAt            DateTime                              @updatedAt @db.Timestamp(3)
  additionalCategories OrderMainAdditionalCategory[]
  orders               Order[]

  @@map("order_main_categories")
}

model OrderAdditionalCategory {
  id             String                                @id @default(uuid()) @db.Uuid
  name           String                                @unique @db.VarChar(100)
  createdAt      DateTime                              @default(now()) @db.Timestamp(3)
  updatedAt      DateTime                              @updatedAt @db.Timestamp(3)
  mainCategories OrderMainAdditionalCategory[]
  orders         OrderAdditionalCategoryLink[]

  @@map("order_additional_categories")
}

model OrderMainAdditionalCategory {
  mainCategoryId       String                  @db.Uuid
  additionalCategoryId String                  @db.Uuid
  mainCategory         OrderMainCategory       @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  additionalCategory   OrderAdditionalCategory @relation(fields: [additionalCategoryId], references: [id], onDelete: Cascade)

  @@id([mainCategoryId, additionalCategoryId])
  @@index([additionalCategoryId])
  @@map("order_main_additional_categories")
}

model OrderAdditionalCategoryLink {
  orderId             String                  @db.Uuid
  additionalCategoryId String                  @db.Uuid
  order               Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  additionalCategory  OrderAdditionalCategory @relation(fields: [additionalCategoryId], references: [id], onDelete: Restrict)

  @@id([orderId, additionalCategoryId])
  @@index([additionalCategoryId])
  @@map("order_additional_category_links")
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("user_sessions")
}

model MainCategory {
  id                   String                           @id @default(uuid()) @db.Uuid
  name                 String                           @unique @db.VarChar(100)
  createdAt            DateTime                         @default(now()) @db.Timestamp(3)
  updatedAt            DateTime                         @updatedAt @db.Timestamp(3)
  additionalCategories MainCategoryAdditionalCategory[]
  inventoryItems       InventoryItem[]

  @@map("main_categories")
}

model AdditionalCategory {
  id             String                           @id @default(uuid()) @db.Uuid
  name           String                           @unique @db.VarChar(100)
  createdAt      DateTime                         @default(now()) @db.Timestamp(3)
  updatedAt      DateTime                         @updatedAt @db.Timestamp(3)
  mainCategories MainCategoryAdditionalCategory[]
  inventoryItems InventoryItemAdditionalCategory[]

  @@map("additional_categories")
}

model MainCategoryAdditionalCategory {
  mainCategoryId       String             @db.Uuid
  additionalCategoryId String             @db.Uuid
  mainCategory         MainCategory       @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  additionalCategory   AdditionalCategory @relation(fields: [additionalCategoryId], references: [id], onDelete: Cascade)

  @@id([mainCategoryId, additionalCategoryId])
  @@index([additionalCategoryId])
  @@map("main_category_additional_categories")
}

model InventoryItem {
  id                   String                            @id @default(uuid()) @db.Uuid
  name                 String                            @db.VarChar(150)
  description          String?
  count                Int                               @default(0)
  mainCategoryId       String                            @db.Uuid
  createdAt            DateTime                          @default(now()) @db.Timestamp(3)
  updatedAt            DateTime                          @updatedAt @db.Timestamp(3)
  mainCategory         MainCategory                      @relation(fields: [mainCategoryId], references: [id], onDelete: Restrict)
  additionalCategories InventoryItemAdditionalCategory[]

  @@index([name])
  @@index([mainCategoryId])
  @@map("inventory_items")
}

model InventoryItemAdditionalCategory {
  inventoryItemId     String             @db.Uuid
  additionalCategoryId String             @db.Uuid
  inventoryItem       InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  additionalCategory  AdditionalCategory @relation(fields: [additionalCategoryId], references: [id], onDelete: Restrict)

  @@id([inventoryItemId, additionalCategoryId])
  @@index([additionalCategoryId])
  @@map("inventory_item_additional_categories")
}
